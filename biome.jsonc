{
  // Keep in sync with the pinned @biomejs/biome version.
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  // Skip whatever .gitignore skips.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Generated by `wrangler types`; reformatting it breaks `--check`.
    // `!!` also keeps Biome's scanner from indexing it.
    // Markdown is hand-formatted; Biome would re-pad tables on every edit.
    "includes": ["**", "!!worker-configuration.d.ts", "!**/*.md"]
  },
  "formatter": {
    // Match the existing code; other defaults already do.
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      // Stricter rules come with the ticket that needs them.
      "preset": "recommended"
    }
  }
}
