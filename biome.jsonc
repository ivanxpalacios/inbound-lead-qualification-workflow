{
  // Must match the installed @biomejs/biome version (pinned exactly in package.json).
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  // Respect .gitignore so node_modules/, .wrangler/ and friends are skipped
  // without repeating the list here.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // worker-configuration.d.ts is generated by `wrangler types`. If Biome
    // reformatted it, `wrangler types --check` would no longer match.
    "includes": ["**", "!worker-configuration.d.ts"]
  },
  "formatter": {
    // Biome defaults to tabs; the existing code uses 2 spaces. Every other
    // formatter default (double quotes, semicolons, trailing commas,
    // 80 columns) already matches the code, so it is left as is.
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      // Recommended set only. Stricter rules are added by the ticket that
      // first needs them, with the reason.
      "preset": "recommended"
    }
  }
}
