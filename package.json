    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "allowScripts": {
    "workerd@1.20261118.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
